{
  "$schema": "https://developer.microsoft.com/en-us/json-schemas/teams/v1.19/MicrosoftTeams.schema.json",
  "manifestVersion": "1.19",
  "version": "1.0.4",
  "id": "${{TEAMS_APP_ID}}",
  "developer": {
    "name": "Power Platform Ninja",
    "websiteUrl": "https://powerplatformninja.com",
    "privacyUrl": "https://powerplatformninja.com",
    "termsOfUseUrl": "https://powerplatformninja.com"
  },
  "icons": {
    "color": "color.png",
    "outline": "outline.png"
  },
  "name": {
    "short": "Collections${{APP_NAME_SUFFIX}}",
    "full": "Collections agent"
  },
  "description": {
    "short": "Collections specialist for the Collections Workspace app.",
    "full": "Analyzes payment behavior, prioritizes overdue invoices and builds aging dashboards from Business Central data, and operates the Collections Workspace model-driven app through its bridge actions."
  },
  "accentColor": "#0F6CBD",
  "composeExtensions": [],
  "permissions": [
    "identity",
    "messageTeamMembers"
  ],
  "copilotAgents": {
    "declarativeAgents": [
      {
        "id": "declarativeAgent",
        "file": "declarativeAgent.json"
      }
    ]
  },
  "validDomains": []
}
