# Copy to .env (never commit it). All values are examples.

PORT=3001
# mock = fixtures + in-memory dashboards (offline, demo fallback)
# dataverse = BC virtual tables + contoso_collectiondashboard via the Dataverse Web API (OBO)
DATA_MODE=mock
# none = anonymous (local development only) | entra = validate Entra bearer tokens
AUTH_MODE=none
# Public HTTPS base URL of this service (used in the OAuth protected-resource metadata)
PUBLIC_BASE_URL=https://collections-mcp.example.azurecontainerapps.io
# Comma-separated browser origins allowed to call /mcp (MCP Inspector, mock host). Copilot calls server-to-server.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:6274
# Override where the built widget HTML lives (defaults to dist/widgets)
# WIDGETS_DIR=

# --- Entra ID (AUTH_MODE=entra) ---
AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000
# Accepted token audiences; default: api://<AZURE_CLIENT_ID>,<AZURE_CLIENT_ID>
# AZURE_AUDIENCES=
# Scope shown in /.well-known/oauth-protected-resource; default api://<client id>/access_as_user
# MCP_SCOPE=

# --- OBO credential for Dataverse (DATA_MODE=dataverse): pick ONE ---
# Preferred on Azure Container Apps (no secret): a user-assigned managed identity that is a
# federated identity credential of the app registration (audience api://AzureADTokenExchange).
# AZURE_MANAGED_IDENTITY_CLIENT_ID=00000000-0000-0000-0000-000000000000
# Workload identity with a projected token file (AKS):
# AZURE_FEDERATED_TOKEN_FILE=/var/run/secrets/azure/tokens/azure-identity-token
# or a certificate (mount the PEM private key as a secret volume):
# AZURE_CLIENT_CERTIFICATE_PATH=/mnt/secrets/mcp-obo.pem
# AZURE_CLIENT_CERTIFICATE_THUMBPRINT=
# or a client secret (store it as a Container Apps secret, never in this file):
# AZURE_CLIENT_SECRET=

# --- Dataverse ---
DATAVERSE_URL=https://yourorg.crm4.dynamics.com
