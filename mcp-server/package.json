{
  "name": "@collections/mcp-server",
  "version": "1.0.0",
  "private": true,
  "description": "MCP Apps server for the Collections agent: tools + ui:// widgets, Dataverse (OBO) or mock data.",
  "type": "module",
  "exports": {
    "./server": "./src/server.ts",
    "./mock-repository": "./src/repository/mock.ts",
    "./widgets": "./src/widgets.ts"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "build:widgets": "vite build -c widgets/vite.config.ts --mode priority-list && vite build -c widgets/vite.config.ts --mode aging-dashboard",
    "build:server": "node scripts/bundle.mjs",
    "build": "npm run build:widgets && npm run build:server",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@azure/msal-node": "^7.2.2",
    "@collections/contract": "*",
    "@collections/domain": "*",
    "@modelcontextprotocol/ext-apps": "^1.7.5",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "express": "^5.3.0",
    "jose": "^6.2.17",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@collections/ui": "*",
    "@fluentui/react-components": "^9.72.0",
    "@types/express": "^5.0.6",
    "@types/react": "^18.3.26",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^5.2.0",
    "esbuild": "^0.25.12",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.20.6",
    "vite": "^7.3.8",
    "vite-plugin-singlefile": "^2.3.4"
  }
}
