# Copy to deploy/tenant.env (git-ignored) and fill in. No secrets here: sign-in is interactive.
DATAVERSE_URL=https://yourorg.crm.dynamics.com
BC_ENVIRONMENT=Production
BC_COMPANY=CRONUS ES
PUBLISHER_PREFIX=ppn
AZURE_LOCATION=eastus
AZURE_RESOURCE_GROUP=rg-xrm-copilot-collections
# Scope the MCP server (and demo) to the customers deploy/bc-seed.mjs created
CUSTOMER_NUMBER_PREFIX=DEMO-C-
# Demo only: show the "Share context with Copilot" switch on the control (bind-pcf.mjs). Off by default: the Copilot
# pane passes the open record to the agent anyway, so the switch only hides what the app adds (docs/production-readiness.md).
SHOW_CONTEXT_SWITCH=false

# Optional: "today" for ageing in the MCP server and the PCF (YYYY-MM-DD). Empty = real date.
DEMO_AS_OF=2026-11-27
